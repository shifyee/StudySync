// Update the User model to include the new relations:
model User {
  // ... keep existing fields ...
  ownedServers      Server[]       @relation("ServerOwner")
  serverMemberships ServerMember[]
  messages          Message[]
}

// Add these new models:
model Server {
  id        String   @id @default(cuid())
  name      String
  iconUrl   String?
  createdAt DateTime @default(now())
  
  ownerId   String
  owner     User     @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  channels  Channel[]
  members   ServerMember[]
}

model ServerMember {
  id        String   @id @default(cuid())
  role      String   @default("STUDENT") // STUDENT, TA, ADMIN
  joinedAt  DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
}

model Channel {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("TEXT") // TEXT, VOICE, WHITEBOARD
  createdAt DateTime @default(now())
  
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
